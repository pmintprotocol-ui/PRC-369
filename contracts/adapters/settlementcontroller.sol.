pragma solidity ^0.8.28;

import "../kernel/Types.sol";
import "../kernel/Errors.sol";
import "./IPositionSettlement.sol";
import "./SettlementRegistry.sol";

/// @title PRC-369 Settlement Controller
/// @author MINTer
/// @notice Coordinates authorized settlement execution for Positions.
/// @dev
/// The Controller does NOT:
/// - Store Position identity.
/// - Store Position runtime.
/// - Define economic settlement rules.
/// - Hold settlement balances.
/// - Register settlement implementations.
///
/// SettlementRegistry remains the authoritative source of
/// settlement implementations.

contract SettlementController {

    //////////////////////////////////////////////////////////////
    // REGISTRY
    //////////////////////////////////////////////////////////////

    /// @notice Authoritative Settlement Registry.
    SettlementRegistry public immutable settlementRegistry;

    //////////////////////////////////////////////////////////////
    // AUTHORITY
    //////////////////////////////////////////////////////////////

    /// @notice Authority allowed to execute settlement.
    address public immutable settlementAuthority;

    //////////////////////////////////////////////////////////////
    // CONSTRUCTOR
    //////////////////////////////////////////////////////////////

    constructor(
        address registryAddress,
        address authority
    ) {
        if (registryAddress == address(0)) {
            revert ZeroAddress();
        }

        if (authority == address(0)) {
            revert ZeroAddress();
        }

        settlementRegistry =
            SettlementRegistry(registryAddress);

        settlementAuthority =
            authority;
    }

    //////////////////////////////////////////////////////////////
    // RESOLVE SETTLEMENT
    //////////////////////////////////////////////////////////////

    /// @notice Resolves the active settlement implementation
    /// for an operation.
    /// @param operation Operation identifier.
    /// @return settlement Settlement implementation address.
    function resolveSettlement(
        bytes32 operation
    )
        external
        view
        returns (address settlement)
    {
        if (operation == bytes32(0)) {
            revert ZeroValue();
        }

        return settlementRegistry.resolveSettlement(
            operation
        );
    }

    //////////////////////////////////////////////////////////////
    // SUPPORT CHECK
    //////////////////////////////////////////////////////////////

    /// @notice Checks whether a Position supports settlement
    /// for a specific operation.
    /// @param positionId Position identifier.
    /// @param operation Operation identifier.
    /// @return supported True if supported.
    function supportsSettlement(
        PositionId positionId,
        bytes32 operation
    )
        external
        view
        returns (bool supported)
    {
        if (operation == bytes32(0)) {
            return false;
        }

        address settlement;

        try settlementRegistry.resolveSettlement(
            operation
        )
            returns (address resolvedSettlement)
        {
            settlement = resolvedSettlement;
        }
        catch {
            return false;
        }

        return
            IPositionSettlement(settlement)
                .supportsSettlement(
                    positionId
                );
    }

    //////////////////////////////////////////////////////////////
    // PREVIEW
    //////////////////////////////////////////////////////////////

    /// @notice Previews a settlement operation.
    /// @param positionId Position identifier.
    /// @param operation Operation identifier.
    /// @param data Settlement-specific parameters.
    /// @return result Preview result.
    function previewSettlement(
        PositionId positionId,
        bytes32 operation,
        bytes calldata data
    )
        external
        view
        returns (bytes memory result)
    {
        if (operation == bytes32(0)) {
            revert ZeroValue();
        }

        address settlement =
            settlementRegistry.resolveSettlement(
                operation
            );

        if (
            !IPositionSettlement(settlement)
                .supportsSettlement(
                    positionId
                )
        ) {
            revert UnsupportedOperation();
        }

        return
            IPositionSettlement(settlement)
                .previewSettlement(
                    positionId,
                    data
                );
    }

    //////////////////////////////////////////////////////////////
    // EXECUTE SETTLEMENT
    //////////////////////////////////////////////////////////////

    /// @notice Executes settlement for a Position.
    /// @param positionId Position identifier.
    /// @param operation Operation identifier.
    /// @param data Settlement-specific parameters.
    /// @return result Settlement result.
    function settle(
        PositionId positionId,
        bytes32 operation,
        bytes calldata data
    )
        external
        returns (bytes memory result)
    {
        _authorize();

        if (operation == bytes32(0)) {
            revert ZeroValue();
        }

        address settlement =
            settlementRegistry.resolveSettlement(
                operation
            );

        if (
            !IPositionSettlement(settlement)
                .supportsSettlement(
                    positionId
                )
        ) {
            revert UnsupportedOperation();
        }

        return
            IPositionSettlement(settlement)
                .settle(
                    positionId,
                    data
                );
    }

    //////////////////////////////////////////////////////////////
    // AUTHORIZATION
    //////////////////////////////////////////////////////////////

    /// @notice Validates Settlement Controller authority.
    function _authorize()
        internal
        view
    {
        if (
            msg.sender != settlementAuthority
        ) {
            revert Unauthorized();
        }
    }
}
